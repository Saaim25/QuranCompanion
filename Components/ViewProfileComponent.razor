@using Blazored.LocalStorage
@using Supabase.Gotrue
@using System.Text.Json
@inject SupabaseAuthStateProvider AuthStateProvider
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation
@inject ILocalStorageService localStorage
@inject IToastService toastService
<div class="profile-popup" @onclick:stopPropagation>
    <h3>User Profile</h3>
    <p><strong>Username:</strong> @Username</p>
    <p><strong>Email:</strong> @Email</p>

    <div class="popup-actions">
        <button class="btn btn-primary" @onclick="Logout">Logout</button>
        <button class="btn btn-secondary" @onclick="Close">Close</button>
    </div>
</div>

@code {
    private string Username { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close() => await OnClose.InvokeAsync();

    protected override async Task OnInitializedAsync()
    {
        Username = await localStorage.GetItemAsync<string>("UserName") ?? ""; 
        Email = await localStorage.GetItemAsync<string>("Email") ?? "";
    }
    private async Task Logout()
    {
        await SupabaseClient.Auth.SignOut();
        ((SupabaseAuthStateProvider)AuthStateProvider).NotifyUserLogout();
        await OnClose.InvokeAsync();
        Navigation.NavigateTo("/login");
        toastService.ShowSuccess("Logged out successfully!");
    }
}