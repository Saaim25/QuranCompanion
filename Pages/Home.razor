@page "/"
@inject Supabase.Client SupabaseClient

<h3>Add a Note</h3>

<div>
    <label>Title:</label>
    <input @bind="newTitle" placeholder="Enter title" />
</div>
<div>
    <label>Content:</label>
    <textarea @bind="newContent" placeholder="Enter note content"></textarea>
</div>
<button @onclick="AddNote">Save Note</button>

<h3>Notes List</h3>
<table>
    <thead>
        <tr>
            <th>Notes ID</th>
            <th>Title</th>
            <th>Content</th>
            <th>Created At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var note in notes)
        {
            <tr>
                <td>@note.Id</td>
                <td>@note.Title</td>
                <td>@note.Content</td>
                <td>@note.CreatedAt</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string newTitle = "";
    private string newContent = "";
    private List<Note> notes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNotes();
    }

    private async Task LoadNotes()
    {
        var response = await SupabaseClient.From<Note>().Get();
        notes = response.Models;
    }

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newContent))
            return;

        var note = new Note { Title = newTitle, Content = newContent };
        await SupabaseClient.From<Note>().Insert(note);

        await LoadNotes();

        newTitle = "";
        newContent = "";
    }
}
